            "spec": {
              "version": 3,
              "widgetType": "bar",
              "frame": {"showTitle": true, "title": "Conversie per categorie (%)"},
              "encodings": {
                "x": {"fieldName": "categorie", "scale": {"type": "categorical"}, "displayName": "categorie"},
                "y": {"fieldName": "conversie_pct", "scale": {"type": "quantitative"}, "displayName": "conversie %"}
              }
            }
          },
          "position": {"x": 0, "y": 9, "width": 2, "height": 6}
        },
        {
          "widget": {
            "name": "bar_funnel",
            "queries": [
              {
                "name": "main_query",
                "query": {
